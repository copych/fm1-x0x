wait 300
tapkey b0
tap OCT+
wait 300
expect vmute 1662
tapkey w1
expect live_mode 0
tap EDIT
spin K1 -5
tap EDIT
tap LFO
expect live_mode 1
tapkey w1
expect vmute 1660
tapkey w1
expect vmute 1662
tap ARP
expect live_mode 4
spin K2 -1
wait 300
shot performer-drums.png
tap LFO
shot performer-mix.png
# Drum-instrument solo in Mixer works even when a 303 is the sound focus.
tapkey b2
tap LFO
press REC
tapkey w1
release REC
expect live_solo 2
tap REC
expect live_solo 0
expect vmute 1662
turn PRESET 1
press REC
tapkey w1
release REC
expect live_solo 2
tap REC
expect live_solo 0
expect vmute 1662

wait 300
tap OCT+
snapline 0
press ENV
tap OCT+
release ENV
wait 200
tap OCT+
expect linechg0 1
press LFO
tap OCT-
release LFO
wait 200
expect linechg0 0
spin K1 7
expect sound2.0.0 55
tap REC
expect linechg0 1
expect sound2.0.0 55
press REC
tap OCT+
release REC
expect linechg0 0
expect sound2.0.0 55
tap ARP
expect live_mode 4
tap ARP
wait 200
expect linechg0 0
tap REC
expect linechg0 0
# Multi-part captures return atomically and remain separate from sound.
tapkey b3
tap OCT+
press SEL
tapkey b2
release SEL
expect live_selected 12
snapline 0
snapline 1
press ENV
tap OCT+
release ENV
wait 300
tap OCT+
expect linechg0 1
expect linechg1 1
press LFO
tap OCT-
release LFO
wait 200
expect linechg0 0
expect linechg1 0
